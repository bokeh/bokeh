# Package files and data
graft src/bokeh/_sri
graft src/bokeh/core/_templates
graft src/bokeh/sampledata/_data
graft src/bokeh/sphinxext/_internal/_templates
include src/bokeh/server/views/*.html
include src/bokeh/server/views/*.ico
include src/bokeh/util/sampledata.json
include src/bokeh/_sri.json
include src/bokeh/LICENSE.txt
include src/bokeh/py.typed
# include generated notebook frontends
include src/bokeh/jupyter/anywidget.js
include src/bokeh/jupyter/logotype.svg
include src/bokeh/jupyter/protocol.json
graft src/bokeh/jupyter/jupyter-config
graft src/bokeh/jupyter/labextension
prune jupyter
global-exclude *.py[cod]

# start with an empty static/ dir
prune src/bokeh/server/static

# include bundles
include src/bokeh/server/static/js/bokeh*.js
include src/bokeh/server/static/js/bokeh*.min.js
include src/bokeh/server/static/js/bokeh*.js.map

# don't include ESM bundles yet
exclude src/bokeh/server/static/js/bokeh*.esm.js
exclude src/bokeh/server/static/js/bokeh*.esm.min.js
exclude src/bokeh/server/static/js/bokeh*.esm.js.map
exclude src/bokeh/server/static/js/bokeh*.esm.min.js.map

# include the extension compiler adapter and pinned npm runtime manifest
include src/bokeh/server/static/js/compiler.js
include src/bokeh/server/static/js/compiler/compiler.mjs
include src/bokeh/server/static/js/compiler/compiler.mjs.map
include src/bokeh/server/static/js/compiler/package.json
include src/bokeh/server/static/js/compiler/package-lock.json
include src/bokeh/server/static/js/compiler/THIRD-PARTY-LICENSE.compiler

# include BokehJS declarations
recursive-include src/bokeh/server/static/js/lib *.d.ts *.d.ts.map
