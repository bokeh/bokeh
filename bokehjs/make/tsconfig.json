{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["node"],
    "paths": {
      "#compiler/*": ["../src/compiler/*"]
    },
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../build/js/make.tsbuildinfo"
  },
  "extends": "../tsconfig.base",
  "include": ["./**/*.ts"],
  "exclude": ["./_build"]
}
