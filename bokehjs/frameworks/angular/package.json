      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.json"
  },
  "dependencies": {
    "@bokeh/framework": "4.0.0-dev.1"
  },
  "peerDependencies": {
    "@angular/core": ">=18 <22",
    "@bokeh/bokehjs": ">=4.0.0-dev.1 <5"
  }
}
