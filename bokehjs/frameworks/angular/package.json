{
  "name": "@bokeh/angular",
  "version": "4.0.0-dev.1",
  "description": "Angular adapter for BokehJS",
  "license": "BSD-3-Clause",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
