{
  "name": "@bokeh/bokehjs",
  "version": "4.0.0-dev.1",
  "description": "Interactive, novel data visualization",
  "keywords": [
    "bokeh",
    "datavis",
    "dataviz",
    "visualization",
    "plotting",
    "plot",
    "graph"
  ],
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bokeh/bokeh.git"
  },
  "engines": {
    "node": ">=16.0",
    "npm": ">=8.0"
  },
  "files": [
    "build/js/bokeh*.min.js",
    "build/esm/bokeh*.js",
    "build/esm/bokeh*.js.map",
    "build/js/lib/**/*.js",
    "build/js/lib/**/*.d.ts"
  ],
  "workspaces": [
    "./examples/frameworks/angular-ng",
    "./examples/frameworks/react-vite",
    "./examples/frameworks/node-ssr-compat",
    "./examples/frameworks/svelte-vite",
    "./examples/frameworks/vanilla-rspack",
    "./examples/frameworks/vanilla-vite",
    "./examples/frameworks/vanilla-webpack",
    "./examples/frameworks/vue-vite",
    "./examples/frameworks/web-component-webpack",
    "./frameworks/base",
    "./frameworks/react",
    "./frameworks/svelte",
    "./frameworks/vue",
    "./frameworks/web-component",
    "./make",
    "./src/compiler",
    "./src/lib",
    "./src/server",
    "./test"
  ],
  "scripts": {
    "prepare": "node ./prepare.mjs",
    "build": "node make build",
    "dev-build": "node make dev-build",
    "test:frameworks": "node make test:frameworks"
  },
  "allowScripts": {
    "esbuild": true
  },
  "main": "build/esm/bokeh.js",
  "module": "build/esm/bokeh.js",
  "types": "build/js/lib/bokeh_package.d.ts",
  "exports": {
    ".": {
      "types": "./build/js/lib/bokeh_package.d.ts",
      "import": "./build/esm/bokeh.js",
      "default": "./build/esm/bokeh.js"
    },
    "./build/js/lib/*.js": "./build/js/lib/*.js",
    "./build/js/lib/*": {
      "types": "./build/js/lib/*.d.ts",
      "import": "./build/js/lib/*.js",
      "default": "./build/js/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@bokeh/numbro": "^1.6.2",
    "@preact/signals": "^2.5.1",
    "@types/geojson": "^7946.0.13",
    "@types/google.maps": "^3.55.5",
    "@types/nearley": "^2.11.5",
    "@types/semver": "^7.7.1",
    "@types/sortablejs": "^1.15.6",
    "@types/sprintf-js": "^1.1.4",
    "choices.js": "^10.2.0",
    "dompurify": "^3.3.0",
    "earcut": "^3.0.2",
    "fflate": "^0.8.2",
    "flatpickr": "^4.6.13",
    "marked": "^17.0.1",
    "mathjax-full": "^3.2.2",
    "nearley": "^2.20.1",
    "nouislider": "^15.7.1",
    "preact": "^10.28.0",
    "proj4": "^2.20.4",
    "regl": "^2.1.0",
    "slickgrid": "^5.19.0",
    "sprintf-js": "^1.1.3",
    "timezone": "^1.0.23",
    "tslib": "^2.8.1",
    "underscore.template": "^0.1.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.8",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-glsl-minify": "^1.5.0"
  }
}
