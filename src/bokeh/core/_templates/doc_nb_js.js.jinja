{% extends "try_run.js.jinja" %}

{% block code_to_run %}
  const docs_json = {{ docs_json }};
  const render_items = {{ render_items }};
  const resource_requirements = {{ resource_requirements|tojson }};
  const resource_assets = {{ resource_assets|tojson }};
  void root.Bokeh.embed.embed_items_notebook(docs_json, render_items, () => root.Bokeh.embed.resource_loader.ensure(
    resource_requirements, {
      mode: "resolved", assets: resource_assets,
      {% if resource_override_version is defined and resource_override_version is not none %}override_version: {{ resource_override_version|tojson }},{% endif %}
    }, {{ bokeh_version|tojson }},
  )).catch((error) => {
    console.error("Failed to display Bokeh notebook output", error)
  });
{% endblock %}
