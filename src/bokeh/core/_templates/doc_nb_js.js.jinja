{% extends "try_run.js.jinja" %}

{% block code_to_run %}
  const docs_json = {{ docs_json }};
  const render_items = {{ render_items }};
  const resource_requirements = {{ resource_requirements|tojson }};
  const resource_assets = {{ resource_assets|tojson }};
  void root.Bokeh.embed.resource_loader.ensure(
    resource_requirements, {mode: "resolved", assets: resource_assets}, {{ bokeh_version|tojson }},
  ).then(() => root.Bokeh.embed.embed_items_notebook(docs_json, render_items));
{% endblock %}
